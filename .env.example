# Orija Media Server
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ORIJA_PORT=8096

# Concurrent streaming limits
MAX_STREAMS_PER_USER=4
MAX_GLOBAL_STREAMS=20

# Optional: seed Xtream Codes on first boot (also configurable in Settings UI)
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# Host paths for local library (favorites from Xtream also land here)
MOVIES_PATH=./media/movies
SHOWS_PATH=./media/shows
LIVE_PATH=./media/live
