# OrijaFlix Media Server
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ORIJA_PORT=8096

# Concurrent streaming limits
MAX_STREAMS_PER_USER=4
MAX_GLOBAL_STREAMS=20

# Optional: seed Xtream Codes on first boot (also configurable in Settings UI)
XTREAM_BASE_URL=
XTREAM_USERNAME=
XTREAM_PASSWORD=

# TMDB — enables title correction + cover artwork in the media sorter
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Host media root (contains movies/ and TVshows/)
MEDIA_HOST_PATH=/srv/storage/data/media
