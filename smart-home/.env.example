# Copy to .env and customize before production use.
# Never commit real secrets.

# --- Gateway ---
GATEWAY_PORT=8080

# --- Postgres ---
POSTGRES_USER=homepulse
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=homepulse

# --- Security ---
# Pepper used when hashing home API keys (rotate carefully)
API_KEY_PEPPER=replace-with-long-random-pepper
# Bearer token for bootstrap/admin registry calls (create home, register devices)
BOOTSTRAP_ADMIN_TOKEN=replace-with-bootstrap-token
# Optional shared secret required on Ring webhook requests
RING_WEBHOOK_SECRET=

# --- Notifications (Google / FCM) ---
# dry_run = log notifications (default for local demo)
# firebase = send real push via Firebase Cloud Messaging
FCM_MODE=dry_run
FCM_PROJECT_ID=
# Path inside the notifier container to the service-account JSON
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json
# Host path mounted read-only into notifier
FCM_CREDENTIALS_HOST_PATH=./secrets

# --- Rules ---
NOTIFY_ON_MOTION=false
LOG_LEVEL=INFO
