# Copy to .env and fill in production values. Never commit real secrets.

# --- Core ---
HOME_ID=11111111-1111-1111-1111-111111111111
DEVICE_ID=ring-doorbell-1
DEVICE_NAME=Front Door Ring
DEMO_API_KEY=sh_demo_key_change_me

# --- Infra credentials (change in production) ---
MQTT_USERNAME=smarthome
MQTT_PASSWORD=smarthome
POSTGRES_USER=smarthome
POSTGRES_PASSWORD=smarthome
POSTGRES_DB=smarthome
REDIS_PASSWORD=smarthome

# --- Ports ---
API_PORT=3100
DASHBOARD_PORT=8080

# --- Ring ---
# true = use dashboard / API simulate endpoint
# false = connect to real Ring account with RING_REFRESH_TOKEN
MOCK_MODE=true
RING_REFRESH_TOKEN=

# --- Google / FCM phone notifications ---
# 1. Create a Firebase project + enable Cloud Messaging
# 2. Download a service account JSON to ./secrets/fcm-service-account.json
# 3. Set FCM_PROJECT_ID and FCM_DEVICE_TOKEN (from your Android/iOS app)
FCM_PROJECT_ID=
FCM_DEVICE_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/fcm-service-account.json
FCM_CREDENTIALS_HOST_PATH=./secrets

# Optional: webhook that speaks on Google Nest / Home Assistant TTS
GOOGLE_HOME_WEBHOOK_URL=

# Optional generic webhook (Slack, ntfy, etc.)
NOTIFY_WEBHOOK_URL=
