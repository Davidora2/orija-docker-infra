{
  "name": "versecast",
  "version": "1.0.0",
  "description": "Church OBS overlay app — live Bible verse lower thirds, captions, and customizable graphics for Windows and Mac",
  "main": "electron/main.cjs",
  "author": "VerseCast",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "fetch-bible": "node scripts/fetch-bible.mjs",
    "server": "node server/standalone.cjs",
    "test": "node scripts/test-bible.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.versecast.app",
    "productName": "VerseCast",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "overlay/**/*",
      "data/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "overlay",
        "to": "overlay"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
