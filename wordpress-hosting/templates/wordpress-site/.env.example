# Copy to sites/<slug>/.env (gitignored) — never commit real passwords.
# Generated by scripts/provision-site.sh

SITE_SLUG=acme
SITE_DOMAIN=acme.orija.store
SITE_TITLE=Acme Site
SITE_TAGLINE=Managed by Orija WordPress Hosting
HOST_PORT=19101

MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=CHANGE_ME_DB
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
WORDPRESS_TABLE_PREFIX=wp_

WP_ADMIN_USER=acmeadmin
WP_ADMIN_PASSWORD=CHANGE_ME_WP
WP_ADMIN_EMAIL=admin@acme.example

WP_MEMORY_LIMIT=256M
WP_MAX_MEMORY_LIMIT=512M
