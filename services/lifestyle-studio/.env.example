# Gemini API key for Nano Banana image models
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Draft model (fast iteration). Options:
#   gemini-3.1-flash-image  (Nano Banana 2 — recommended)
#   gemini-3.1-flash-lite-image
#   gemini-2.5-flash-image
NANOBANANA_DRAFT_MODEL=gemini-3.1-flash-image

# Bake / high-res model. Options:
#   gemini-3.1-flash-image
#   gemini-3-pro-image      (Nano Banana Pro — highest fidelity)
NANOBANANA_BAKE_MODEL=gemini-3-pro-image

# Draft resolution: 1K (fast). Bake default: 2K or 4K
NANOBANANA_DRAFT_SIZE=1K
NANOBANANA_BAKE_SIZE=2K

# If true and GEMINI_API_KEY is empty, UI still works with placeholder drafts
ALLOW_MOCK_WITHOUT_KEY=true

# Server
HOST=0.0.0.0
PORT=8080
DATA_DIR=/data
BRAND_NAME=Orija
