# --- Mode ---
# dry_run = compose pins locally, do not post
# live = post to Pinterest
PIN_AGENT_MODE=dry_run

# Post cadence (hours between pins). ~1 every 2 hours = 12/day.
PIN_INTERVAL_HOURS=2
# Optional quiet hours (24h local). Example: skip 00:00-07:00
PIN_QUIET_START_HOUR=
PIN_QUIET_END_HOUR=
PIN_TIMEZONE=America/New_York

# --- Shopify (custom Admin API app) ---
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxx
SHOPIFY_API_VERSION=2025-01
# Optional: only pin products with these tags (comma-separated). Empty = all active.
SHOPIFY_PRODUCT_TAG_FILTER=
# Optional: max products to consider per cycle
SHOPIFY_PRODUCT_LIMIT=50

# --- Pinterest (Developer app + OAuth) ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_BOARD_ID=
# Optional: default link override. Empty = use product URL from Shopify.
PINTEREST_DEFAULT_LINK=
# Use sandbox API during testing (true/false)
PINTEREST_USE_SANDBOX=false

# --- Brand / content ---
BRAND_NAME=Orija
BRAND_VOICE=warm, practical, SEO-friendly. Short sentences. No hype.
# Optional OpenAI key for richer captions. Leave empty to use templates.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Paths (mounted volumes in Docker) ---
DATA_DIR=/data
CONFIG_DIR=/app/config