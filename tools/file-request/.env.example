# Independent stack on the same host as Immich.
# docker compose up -d --build

# Public URL people will open (change if you reverse-proxy this stack)
BASE_URL=http://localhost:3847
PORT=3847

# Admin UI password
ADMIN_PASSWORD=change-me

# Immich on this same machine (published port, default 2283)
IMMICH_URL=http://host.docker.internal:2283

# Kept for compatibility. Uploads are never capped; public transfers use 8MB chunks.
MAX_FILE_MB=0

# Optional: join Immich's compose network instead of host.docker.internal
# IMMICH_DOCKER_NETWORK=immich_default
# Then: docker compose -f docker-compose.yml -f docker-compose.immich-network.yml up -d
# and set IMMICH_URL=http://immich-server:2283
