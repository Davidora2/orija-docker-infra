# Server
PORT=3847
BASE_URL=http://localhost:3847

# Protect admin UI / API (leave empty to disable auth — local use only)
ADMIN_PASSWORD=change-me

# Where uploaded request files are stored before admin moves them
UPLOAD_ROOT=./data/uploads

# Immich external library folders (name=path). Paths should be the same
# directories Immich watches as external libraries (local mounts or SMB mounts).
# Example: Family=/mnt/immich/external/family,Vacation=/mnt/immich/external/vacation
IMMICH_FOLDERS=Inbox=./data/immich-external/inbox,Family=./data/immich-external/family,Vacation=./data/immich-external/vacation

# Max upload size per file (MB)
MAX_FILE_MB=100

# Optional starting Immich URL. User API keys are added in the admin UI
# (Immich → Account Settings → API Keys). Each key uploads as that user.
IMMICH_URL=http://127.0.0.1:2283
