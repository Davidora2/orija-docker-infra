{
  "expo": {
    "name": "Immich Send",
    "slug": "immich-send",
    "scheme": "immichsend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f6b5c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.orija.immichsend",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos and videos to send to Immich.",
        "NSCameraUsageDescription": "Take a photo to send to Immich."
      }
    },
    "android": {
      "package": "co.orija.immichsend",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f6b5c",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to send to Immich.",
          "cameraPermission": "Take a photo to send to Immich."
        }
      ]
    ]
  }
}
