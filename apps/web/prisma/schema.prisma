generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String // BRAND | CREATOR | ADMIN
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceMembers WorkspaceMember[]
  creator          Creator?
  sentMessages     Message[]         @relation("MessageSender")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           WorkspaceMember[]
  campaigns         Campaign[]
  creatorLists      CreatorList[]
  outreachTemplates OutreachTemplate[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("manager")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Creator {
  id                String   @id @default(cuid())
  userId            String   @unique
  handle            String   @unique
  bio               String?
  niches            String   @default("[]")
  location          String?
  languages         String   @default("[\"en\"]")
  rateMinCents      Int?
  rateMaxCents      Int?
  engagementRate    Float?
  authenticityScore Float?
  topics            String   @default("[]")
  contentSummary    String?
  mediaKitUrl       String?
  paymentReady      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]
  posts          CreatorPost[]
  listItems      CreatorListItem[]
  memberships    CampaignCreator[]
  applications   Application[]
}

model SocialAccount {
  id             String    @id @default(cuid())
  creatorId      String
  platform       String // INSTAGRAM | TIKTOK | YOUTUBE | X | BLOG | OTHER
  handle         String
  url            String?
  followerCount  Int       @default(0)
  followingCount Int       @default(0)
  avgViews       Int?
  isConnected    Boolean   @default(false)
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, platform])
}

model CreatorPost {
  id        String    @id @default(cuid())
  creatorId String
  platform  String
  url       String?
  caption   String?
  hashtags  String    @default("[]")
  mediaType String    @default("post")
  likes     Int       @default(0)
  comments  Int       @default(0)
  views     Int       @default(0)
  shares    Int       @default(0)
  topics    String    @default("[]")
  postedAt  DateTime?
  createdAt DateTime  @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model CreatorList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     CreatorListItem[]
}

model CreatorListItem {
  id        String   @id @default(cuid())
  listId    String
  creatorId String
  notes     String?
  createdAt DateTime @default(now())

  list    CreatorList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creator Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([listId, creatorId])
}

model Campaign {
  id                  String    @id @default(cuid())
  workspaceId         String
  title               String
  slug                String
  status              String    @default("DRAFT") // DRAFT | ACTIVE | PAUSED | COMPLETED | CANCELED
  objective           String?
  platforms           String    @default("[]")
  brief               String
  terms               String
  dosAndDonts         String?
  assetsNote          String?
  compModel           String    @default("PAID") // PAID | GIFTING | AFFILIATE | HYBRID
  budgetCents         Int?
  feeCents            Int?
  giftDescription     String?
  affiliateRate       Float?
  affiliateCookieDays Int       @default(30)
  applicationOpen     Boolean   @default(true)
  startsAt            DateTime?
  endsAt              DateTime?
  previewToken        String    @unique @default(cuid())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requirements DeliverableRequirement[]
  memberships  CampaignCreator[]
  applications Application[]
  templates    OutreachTemplate[]       @relation("CampaignTemplates")

  @@unique([workspaceId, slug])
}

model DeliverableRequirement {
  id          String  @id @default(cuid())
  campaignId  String
  platform    String
  contentType String
  quantity    Int     @default(1)
  description String?
  dueDays     Int?

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
}

model CampaignCreator {
  id              String    @id @default(cuid())
  campaignId      String
  creatorId       String
  status          String    @default("INVITED")
  offeredFeeCents Int?
  notes           String?
  invitedAt       DateTime  @default(now())
  appliedAt       DateTime?
  acceptedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  campaign       Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator        Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  messages       Message[]
  affiliateAsset AffiliateAsset?
  deliverables   Deliverable[]
  payouts        Payout[]
  commissions    CommissionEntry[]

  @@unique([campaignId, creatorId])
}

model Application {
  id               String   @id @default(cuid())
  campaignId       String
  creatorId        String
  pitch            String
  proposedFeeCents Int?
  timeline         String?
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
}

model Message {
  id                String   @id @default(cuid())
  campaignCreatorId String
  senderUserId      String
  subject           String?
  body              String
  templateId        String?
  isOutreach        Boolean  @default(false)
  createdAt         DateTime @default(now())

  campaignCreator CampaignCreator   @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  sender          User              @relation("MessageSender", fields: [senderUserId], references: [id])
  template        OutreachTemplate? @relation(fields: [templateId], references: [id])
}

model OutreachTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  campaignId  String?
  name        String
  subject     String
  body        String
  channel     String   @default("email")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation("CampaignTemplates", fields: [campaignId], references: [id])
  messages  Message[]
}

model AffiliateAsset {
  id                String   @id @default(cuid())
  campaignCreatorId String   @unique
  trackingCode      String   @unique
  landingUrl        String
  promoCode         String?
  clicks            Int      @default(0)
  conversions       Int      @default(0)
  revenueCents      Int      @default(0)
  createdAt         DateTime @default(now())

  campaignCreator CampaignCreator  @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  events          AffiliateEvent[]
}

model AffiliateEvent {
  id               String   @id @default(cuid())
  affiliateAssetId String
  type             String
  amountCents      Int?
  meta             String?
  createdAt        DateTime @default(now())

  affiliateAsset AffiliateAsset @relation(fields: [affiliateAssetId], references: [id], onDelete: Cascade)
}

model Deliverable {
  id                String    @id @default(cuid())
  campaignCreatorId String
  requirementId     String?
  platform          String
  contentType       String
  status            String    @default("PENDING")
  postUrl           String?
  caption           String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  liveAt            DateTime?
  impressions       Int       @default(0)
  reach             Int       @default(0)
  likes             Int       @default(0)
  comments          Int       @default(0)
  shares            Int       @default(0)
  views             Int       @default(0)
  saves             Int       @default(0)
  engagementRate    Float?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaignCreator CampaignCreator         @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  requirement     DeliverableRequirement? @relation(fields: [requirementId], references: [id])
}

model Payout {
  id                String    @id @default(cuid())
  campaignCreatorId String
  amountCents       Int
  currency          String    @default("USD")
  status            String    @default("PENDING")
  method            String    @default("stripe")
  reference         String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
}

model CommissionEntry {
  id                String   @id @default(cuid())
  campaignCreatorId String
  amountCents       Int
  orderRef          String?
  note              String?
  createdAt         DateTime @default(now())

  campaignCreator CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
}
