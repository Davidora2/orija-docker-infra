NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://lifeos:change-me@localhost:5432/lifeos
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ORIGINS=http://localhost:3001,http://localhost:3002
PUBLIC_APP_URL=http://localhost:3001
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
AUTO_MIGRATE=true

# Gmail SMTP (App Password) for forgot-password codes
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=Life OS <you@gmail.com>

# Optional Google Sign-In (OAuth client IDs, comma-separated)
# GOOGLE_CLIENT_IDS=123456789-abc.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# Optional Microsoft Sign-In + Outlook calendar
# MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MICROSOFT_CLIENT_SECRET=...
# MICROSOFT_TENANT_ID=common

# Optional dedicated key for encrypting calendar refresh tokens (defaults to JWT_SECRET)
# CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
